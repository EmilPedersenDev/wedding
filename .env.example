# Kopiera till .env för lokal utveckling. Krävs i BYGGMILJÖN (inte bara lokalt)
# för statisk generering — se kommentaren vid runtimeConfig i nuxt.config.ts.

# Cloudflare Turnstile site key (publik, säker att exponera i klienten).
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEM49fmWzQHuMAY2

# Lämna tom för att använda standardvärdet i nuxt.config.ts.
NUXT_PUBLIC_RSVP_ENDPOINT=
